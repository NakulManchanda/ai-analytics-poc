{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "analytics": false,
  "useInferencePlugins": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/tests/**/*",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/*.spec.*",
      "!{projectRoot}/**/*.md"
    ],
    "sharedGlobals": ["{workspaceRoot}/nx.json"],
    "pythonTooling": ["{workspaceRoot}/pyproject.toml"],
    "datasetConfig": ["{workspaceRoot}/config/datasets/**/*"],
    "captureContract": ["{workspaceRoot}/services/app/app/capture/**/*"],
    "promptBundles": ["{workspaceRoot}/services/app/app/prompts/bundles.py"],
    "rootMakefile": ["{workspaceRoot}/Makefile"],
    "mapContract": [
      "{workspaceRoot}/config/datasets/nyc_yellow_taxi_2024_01.toml",
      "{workspaceRoot}/web/src/map/taxi-zones.v1.json",
      "{workspaceRoot}/web/src/map/fixtures/**/*",
      "{workspaceRoot}/services/app/app/artifacts/taxi_zones_v1.json"
    ],
    "datasetSpike": ["{workspaceRoot}/services/dataset_spike/**/*"],
    "mcpToolSchemas": ["{workspaceRoot}/services/mcp/mcp_server/**/*"],
    "litellmConfig": ["{workspaceRoot}/infra/litellm/config.yaml"],
    "terraformConfig": ["{workspaceRoot}/infra/terraform/*.tf"],
    "inferenceBundle": [
      "{workspaceRoot}/infra/inference/**/*",
      "{workspaceRoot}/infra/observability/inference/**/*",
      "{workspaceRoot}/Makefile"
    ]
  },
  "targetDefaults": {
    "test": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "format-check": {
      "cache": true
    },
    "compile": {
      "cache": true
    },
    "build": {
      "cache": true
    },
    "fixture-report": {
      "cache": true
    },
    "dev": {
      "cache": false
    },
    "worker": {
      "cache": false
    },
    "deploy": {
      "cache": false
    },
    "run-live": {
      "cache": false
    },
    "review-serve": {
      "cache": false
    }
  }
}
