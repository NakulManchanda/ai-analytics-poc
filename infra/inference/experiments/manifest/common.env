# Run-manifest inputs for the replayer (#123). Non-secret; keep separate from .env (which holds the HF token and SSH settings).
# Usage: do not source this directly; source the experiment file (e.g. infra/inference/experiments/manifest/e3-routing.env),
# which sources this one and sets RUN_ID. Needed in every terminal that runs make replay-* / run_scenario.py.
# Use the SAME values for every run in a comparison; unset values are recorded as "unknown" and the comparison is void.
# Keep in sync with k8s/workers/worker-a.yaml and worker-b.yaml (identical args); check with: make inference-verify-workers.
# Not read by the make inference-* scripts.
export MODEL_REVISION=c1899de289a04d12100db370d81485cdf75e47ca      # worker --revision
export TOKENIZER_REVISION=$MODEL_REVISION                           # confirmed in the vLLM 0.11.0 startup log (tokenizer_revision == revision)
export CHAT_TEMPLATE_REVISION=$MODEL_REVISION                       # ASSUMPTION: template ships with the tokenizer in the model repo
export ENGINE_FLAGS="--dtype bfloat16 --kv-cache-dtype auto --max-model-len 8192 --max-num-seqs 8 --max-num-batched-tokens 8192 --block-size 16 --enable-prefix-caching --enable-auto-tool-choice --tool-call-parser hermes --gpu-memory-utilization 0.45"
# vLLM defaults NOT in ENGINE_FLAGS but part of the engine config (seen in the startup log, same on both workers):
#   chunked_prefill_enabled=True (V1 default). Printed by make inference-verify-workers; re-check if VLLM_VERSION changes.
export VLLM_VERSION=0.11.0                                          # image vllm/vllm-openai:v0.11.0
export KV_BLOCK_SIZE=16                                             # worker --block-size
export INFERENCE_TOPOLOGY="two vLLM replicas/HAMi slices on one physical A100"
# optional SLO overrides (defaults: TTFT 100 ms, E2E 3500 ms):
# export INTERACTIVE_TTFT_SLO_MS=100
# export E2E_SLO_MS=3500
