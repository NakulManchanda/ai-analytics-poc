# E0 capacity / first limiter. Source this, not common.env:   source infra/inference/experiments/manifest/e0-capacity.env
# bash/zsh. Override D to reuse a session date:   D=20261004 source ...
source "$(dirname "${BASH_SOURCE[0]:-$0}")/common.env"
export RUN_ID="d123-${D:-$(date +%Y%m%d)}-e0"
