# E3 routing: least_loaded vs prefix_then_load. Source this, not common.env:   source infra/inference/experiments/manifest/e3-routing.env
# bash/zsh. RUN_ID = d123-<date>-<exp>-<HHMM> (local time) so reruns never overwrite. Pin with D=20261004 T=2301 source ...
source "$(dirname "${BASH_SOURCE[0]:-$0}")/common.env"
export RUN_ID="d123-${D:-$(date +%Y%m%d)}-e3-${T:-$(date +%H%M)}"   # -HHMM suffix: every sourcing (rerun) gets its own folder
# Experiment-specific overrides go below (keep identical for BOTH arms of this experiment's comparison):
# export INTERACTIVE_TTFT_SLO_MS=100
# export E2E_SLO_MS=3500
