      },
      "id": 1,
      "options": {
        "content": "`running / 8` (the configured `max_num_seqs`) is a slot-saturation line: as it approaches 1.0 the scheduler is admitting as many sequences as it is allowed to, regardless of remaining KV headroom. A rising `waiting` count with `running` pinned at the max means new requests are queueing behind the slot limit, not the KV cache.",
        "mode": "markdown"
      },
      "title": "How to read this",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vllm:num_requests_running",
          "legendFormat": "running {{instance}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vllm:num_requests_waiting",
          "legendFormat": "waiting {{instance}}",
          "refId": "B"
        }
      ],
      "title": "Running vs waiting per worker",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
