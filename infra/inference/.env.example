# Copy to infra/inference/.env locally. This file is never synchronized.
LAMBDA_SSH_HOST=
LAMBDA_SSH_USER=ubuntu
LAMBDA_SSH_KEY_PATH=
INFERENCE_REMOTE_DIR='~/ai-analytics-inference'
INFERENCE_NAMESPACE=inference-lab
INFERENCE_MODEL=Qwen/Qwen3-0.6B
INFERENCE_MODEL_REVISION=c1899de289a04d12100db370d81485cdf75e47ca
INFERENCE_VLLM_IMAGE=vllm/vllm-openai:v0.11.0
INFERENCE_K3S_VERSION=v1.37.0+k3s1
INFERENCE_HELM_VERSION=v3.22.0
INFERENCE_HAMI_VERSION=2.9.0
# Optional; secret.sh streams this value over SSH and never writes a remote file.
HF_TOKEN=
# Optional; overflow destination key for the C6/C8 demo. secret.sh streams it into the overflow-credentials Secret.
SUPERLINKED_API_KEY=
# Overflow destination for make inference-overflow-on (C6/C8 only). URL is the OpenAI-compatible chat route.
OVERFLOW_URL=https://api.superlinked.com
OVERFLOW_MODEL=Qwen/Qwen3.8-27B-FP8
OVERFLOW_PROVIDER=superlinked
