# LiteLLM Proxy (issue #168): the default model path for ai-app. Stateless, internal-only via
# Service Connect; it holds the Bedrock IAM identity. Config is the single file shared with
# local Compose (infra/litellm/config.yaml).

resource "aws_cloudwatch_log_group" "litellm" {
  name              = "/ecs/${local.name}-litellm"
  retention_in_days = var.log_retention_in_days
}

# Master key is generated by Secrets Manager; its value is never in code or tfvars.
data "aws_secretsmanager_random_password" "litellm_master_key" {
  password_length     = 40
  exclude_punctuation = true
}

resource "aws_secretsmanager_secret" "litellm_master_key" {
  name                    = "${local.name}-litellm-master-key"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "litellm_master_key" {
  secret_id     = aws_secretsmanager_secret.litellm_master_key.id
  secret_string = "sk-${data.aws_secretsmanager_random_password.litellm_master_key.random_password}"

  lifecycle {
    ignore_changes = [secret_string]
  }
}

data "aws_iam_policy_document" "litellm_secret_read" {
  statement {
    sid       = "ReadLiteLLMMasterKey"
    effect    = "Allow"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = [aws_secretsmanager_secret.litellm_master_key.arn]
  }
}

resource "aws_iam_role_policy" "ecs_task_execution_litellm_secret" {
  name   = "${local.name}-litellm-secret-read"
  role   = aws_iam_role.ecs_task_execution.id
  policy = data.aws_iam_policy_document.litellm_secret_read.json
}

resource "aws_iam_role" "litellm_task" {
  name               = "${local.name}-litellm-task"
  assume_role_policy = data.aws_iam_policy_document.ecs_assume_role.json
}

data "aws_iam_policy_document" "litellm_task" {
  statement {
    sid       = "InvokeConfiguredBedrockModels"
    effect    = "Allow"
    actions   = ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"]
    resources = var.bedrock_model_arns
  }
}

resource "aws_iam_role_policy" "litellm_task" {
  name   = "${local.name}-litellm-task"
  role   = aws_iam_role.litellm_task.id
  policy = data.aws_iam_policy_document.litellm_task.json
}

resource "aws_ecs_task_definition" "litellm" {
  family                   = "${local.name}-litellm"
  network_mode             = "awsvpc"
  requires_compatibilities = ["FARGATE"]
  cpu                      = tostring(var.litellm_cpu)
  memory                   = tostring(var.litellm_memory)
  execution_role_arn       = aws_iam_role.ecs_task_execution.arn
  task_role_arn            = aws_iam_role.litellm_task.arn

  container_definitions = jsonencode([
    {
      name      = "litellm"
      image     = var.litellm_image
      essential = true
      # Write the shared config from env, then start the proxy.
      entryPoint = ["sh", "-c", "printf '%s' \"$LITELLM_CONFIG_YAML\" > /tmp/config.yaml && exec litellm --config /tmp/config.yaml --port 4000"]
      portMappings = [
        {
          name          = "litellm"
          containerPort = 4000
          hostPort      = 4000
          protocol      = "tcp"
          appProtocol   = "http"
        }
      ]
      environment = [
        {
          name  = "LITELLM_CONFIG_YAML"
          value = file("${path.module}/../litellm/config.yaml")
        },
        {
          name  = "AWS_REGION"
          value = var.aws_region
        }
      ]
      secrets = [
        {
          name      = "LITELLM_MASTER_KEY"
          valueFrom = aws_secretsmanager_secret.litellm_master_key.arn
        }
      ]
      healthCheck = {
        command     = ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:4000/health/readiness')\""]
        interval    = 15
        timeout     = 5
        retries     = 5
        startPeriod = 60
      }
      logConfiguration = {
        logDriver = "awslogs"
        options = {
          "awslogs-group"         = aws_cloudwatch_log_group.litellm.name
          "awslogs-region"        = var.aws_region
          "awslogs-stream-prefix" = "ecs"
        }
      }
    }
  ])
}

resource "aws_ecs_service" "litellm" {
  count = var.demo_enabled ? 1 : 0

  name            = "${local.name}-litellm"
  cluster         = aws_ecs_cluster.main.id
  task_definition = aws_ecs_task_definition.litellm.arn
  desired_count   = var.litellm_desired_count
  launch_type     = "FARGATE"

  network_configuration {
    subnets          = aws_subnet.public[*].id
    security_groups  = [aws_security_group.ecs_tasks.id]
    assign_public_ip = true
  }

  service_connect_configuration {
    enabled   = true
    namespace = aws_service_discovery_http_namespace.main.arn
    service {
      client_alias {
        port     = 4000
        dns_name = "litellm"
      }
      port_name      = "litellm"
      discovery_name = "litellm"
    }
  }
}
