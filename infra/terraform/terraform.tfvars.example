# Copy this file to terraform.tfvars and choose the intended demo region/AZs.
# Do not place credentials or secret values in this file.
aws_region = "us-east-1"

availability_zones = [
  "us-east-1a",
  "us-east-1b",
]

public_subnet_cidrs = [
  "10.42.0.0/24",
  "10.42.1.0/24",
]

private_subnet_cidrs = [
  "10.42.16.0/20",
  "10.42.32.0/20",
]

# Add only model ARNs approved for this POC. An empty list grants no Bedrock
# invocation permission; that is the safe default until Milestone 4 selects one.
bedrock_model_arns = []

# Optional AWS Budget alerts (Milestone 13 / Bedrock cost controls safety net).
# Set enable_budget_alerts = true to provision the $10 monthly budget with
# $5 actual, $8 actual, $10 actual, and $10 forecasted email notifications.
# Pass a real notification address via ignored local terraform.tfvars or TF_VAR_budget_alert_email.
# Note: AWS Budgets forecasted alerts require historical usage data and may not trigger early on new accounts.
enable_budget_alerts     = false
budget_alert_email       = "alert-recipient@example.com"
monthly_budget_limit_usd = "10.0"
