# Copy this file to terraform.tfvars and choose the intended demo region/AZs.
# Do not place credentials or secret values in this file.
aws_region = "us-east-1"

availability_zones = [
  "us-east-1a",
  "us-east-1b",
]

public_subnet_cidrs = [
  "10.42.0.0/24",
  "10.42.1.0/24",
]

private_subnet_cidrs = [
  "10.42.16.0/20",
  "10.42.32.0/20",
]

# Permit only the Bedrock model configured by the Milestone 4 ai-app service.
# analytics-mcp has no Bedrock policy regardless of this value.
bedrock_model_arns = [
  "arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-micro-v1:0",
]
